{
  "name": "iot-fleet-provisioning-device",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "description": "Local Linux container that provisions itself with AWS IoT Core",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "aws-iot-device-sdk-v2": "^1.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
